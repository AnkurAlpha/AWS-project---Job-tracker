{
  "agent": { "metrics_collection_interval": 300 },
  "metrics": {
    "namespace": "JobTracker/App",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"], "metrics_collection_interval": 300 },
      "disk": { "measurement": ["used_percent"], "resources": ["/"], "metrics_collection_interval": 300 }
    }
  },
  "logs": {
    "logs_collected": {
      "files": { "collect_list": [{
        "file_path": "/opt/jobtracker/logs/operations.log",
        "log_group_name": "/jobtracker/operations",
        "log_stream_name": "{instance_id}/operations"
      }] }
    }
  }
}
