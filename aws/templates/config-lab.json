{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Cost-gated AWS Config: narrowly scoped recorder and encrypted-EBS/private-S3 rules. Check existing account recorder first.",
  "Metadata": {
    "DeploymentStatus": "NOT DEPLOYED; offline smoke only",
    "CostNotice": "Disabled defaults are not a promise of free operation when enabled."
  },
  "Parameters": {
    "EnableResources": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    },
    "ProjectName": {
      "Type": "String",
      "Default": "jobtracker-lab",
      "MaxLength": 24,
      "AllowedPattern": "[a-z][a-z0-9-]{2,23}"
    },
    "AcknowledgeHourlyCharges": {
      "Type": "String",
      "Default": "no",
      "AllowedValues": [
        "no",
        "yes"
      ],
      "Description": "This lab has ongoing costs and may require a Paid plan. Never upgrade automatically."
    },
    "ExistingDeliveryBucket": {
      "Type": "String"
    }
  },
  "Conditions": {
    "Enabled": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "EnableResources"
            },
            "true"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "AcknowledgeHourlyCharges"
            },
            "yes"
          ]
        }
      ]
    }
  },
  "Resources": {
    "RecorderRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "Enabled",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "config.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ProjectOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeVolumes",
                    "ec2:DescribeSecurityGroups",
                    "ec2:DescribeInstances"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketAcl",
                    "s3:GetBucketLocation",
                    "s3:GetBucketPolicy",
                    "s3:GetBucketPublicAccessBlock",
                    "s3:GetEncryptionConfiguration"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ExistingDeliveryBucket}/AWSLogs/${AWS::AccountId}/Config/*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "Recorder": {
      "Type": "AWS::Config::ConfigurationRecorder",
      "Condition": "Enabled",
      "Properties": {
        "RoleARN": {
          "Fn::GetAtt": [
            "RecorderRole",
            "Arn"
          ]
        },
        "RecordingGroup": {
          "AllSupported": false,
          "IncludeGlobalResourceTypes": false,
          "ResourceTypes": [
            "AWS::EC2::Volume",
            "AWS::S3::Bucket",
            "AWS::EC2::SecurityGroup"
          ]
        }
      }
    },
    "Delivery": {
      "Type": "AWS::Config::DeliveryChannel",
      "Condition": "Enabled",
      "Properties": {
        "S3BucketName": {
          "Ref": "ExistingDeliveryBucket"
        }
      }
    },
    "EncryptedEbs": {
      "Type": "AWS::Config::ConfigRule",
      "Condition": "Enabled",
      "Properties": {
        "Scope": {
          "ComplianceResourceTypes": [
            "AWS::EC2::Volume"
          ]
        },
        "Source": {
          "Owner": "AWS",
          "SourceIdentifier": "ENCRYPTED_VOLUMES"
        }
      },
      "DependsOn": [
        "Recorder"
      ]
    },
    "PrivateS3": {
      "Type": "AWS::Config::ConfigRule",
      "Condition": "Enabled",
      "Properties": {
        "Scope": {
          "ComplianceResourceTypes": [
            "AWS::S3::Bucket"
          ]
        },
        "Source": {
          "Owner": "AWS",
          "SourceIdentifier": "S3_BUCKET_PUBLIC_READ_PROHIBITED"
        }
      },
      "DependsOn": [
        "Recorder"
      ]
    }
  },
  "Outputs": {
    "RecorderName": {
      "Value": {
        "Ref": "Recorder"
      },
      "Condition": "Enabled"
    }
  },
  "Rules": {
    "AcknowledgeCost": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Or": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "EnableResources"
                  },
                  "false"
                ]
              },
              {
                "Fn::Equals": [
                  {
                    "Ref": "AcknowledgeHourlyCharges"
                  },
                  "yes"
                ]
              }
            ]
          },
          "AssertDescription": "Hourly or paid-feature costs must be acknowledged before enabling this lab."
        }
      ]
    }
  }
}
