{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Cost-gated DMS full-load/CDC reference. Creates no running migration task automatically; instance has hourly/storage costs.",
  "Metadata": {
    "DeploymentStatus": "NOT DEPLOYED; offline smoke only",
    "CostNotice": "Disabled defaults are not a promise of free operation when enabled."
  },
  "Parameters": {
    "EnableResources": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    },
    "ProjectName": {
      "Type": "String",
      "Default": "jobtracker-lab",
      "MaxLength": 24,
      "AllowedPattern": "[a-z][a-z0-9-]{2,23}"
    },
    "AcknowledgeHourlyCharges": {
      "Type": "String",
      "Default": "no",
      "AllowedValues": [
        "no",
        "yes"
      ],
      "Description": "This lab has ongoing costs and may require a Paid plan. Never upgrade automatically."
    },
    "PrivateSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "ReplicationSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "SecretsAccessRoleArn": {
      "Type": "String"
    },
    "SourceSecretArn": {
      "Type": "String"
    },
    "TargetSecretArn": {
      "Type": "String"
    },
    "SourceCertificateArn": {
      "Type": "String"
    },
    "TargetCertificateArn": {
      "Type": "String"
    }
  },
  "Conditions": {
    "Enabled": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "EnableResources"
            },
            "true"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "AcknowledgeHourlyCharges"
            },
            "yes"
          ]
        }
      ]
    }
  },
  "Resources": {
    "Subnets": {
      "Type": "AWS::DMS::ReplicationSubnetGroup",
      "Condition": "Enabled",
      "Properties": {
        "ReplicationSubnetGroupDescription": "Private migration tier",
        "SubnetIds": {
          "Ref": "PrivateSubnetIds"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "Replication": {
      "Type": "AWS::DMS::ReplicationInstance",
      "Condition": "Enabled",
      "Properties": {
        "ReplicationInstanceClass": "dms.t3.micro",
        "AllocatedStorage": 50,
        "MultiAZ": false,
        "PubliclyAccessible": false,
        "ReplicationSubnetGroupIdentifier": {
          "Ref": "Subnets"
        },
        "VpcSecurityGroupIds": [
          {
            "Ref": "ReplicationSecurityGroupId"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "Source": {
      "Type": "AWS::DMS::Endpoint",
      "Condition": "Enabled",
      "Properties": {
        "EndpointType": "source",
        "EngineName": "postgres",
        "SslMode": "verify-full",
        "CertificateArn": {
          "Ref": "SourceCertificateArn"
        },
        "PostgreSqlSettings": {
          "SecretsManagerSecretId": {
            "Ref": "SourceSecretArn"
          },
          "SecretsManagerAccessRoleArn": {
            "Ref": "SecretsAccessRoleArn"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "Target": {
      "Type": "AWS::DMS::Endpoint",
      "Condition": "Enabled",
      "Properties": {
        "EndpointType": "target",
        "EngineName": "postgres",
        "SslMode": "verify-full",
        "CertificateArn": {
          "Ref": "TargetCertificateArn"
        },
        "PostgreSqlSettings": {
          "SecretsManagerSecretId": {
            "Ref": "TargetSecretArn"
          },
          "SecretsManagerAccessRoleArn": {
            "Ref": "SecretsAccessRoleArn"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "Task": {
      "Type": "AWS::DMS::ReplicationTask",
      "Condition": "Enabled",
      "Properties": {
        "MigrationType": "full-load-and-cdc",
        "ReplicationInstanceArn": {
          "Ref": "Replication"
        },
        "SourceEndpointArn": {
          "Ref": "Source"
        },
        "TargetEndpointArn": {
          "Ref": "Target"
        },
        "TableMappings": "{\"rules\": [{\"rule-type\": \"selection\", \"rule-id\": \"1\", \"rule-name\": \"jobs\", \"object-locator\": {\"schema-name\": \"public\", \"table-name\": \"jobs\"}, \"rule-action\": \"include\"}, {\"rule-type\": \"selection\", \"rule-id\": \"2\", \"rule-name\": \"applications\", \"object-locator\": {\"schema-name\": \"public\", \"table-name\": \"applications\"}, \"rule-action\": \"include\"}, {\"rule-type\": \"selection\", \"rule-id\": \"3\", \"rule-name\": \"admin_users\", \"object-locator\": {\"schema-name\": \"public\", \"table-name\": \"admin_users\"}, \"rule-action\": \"include\"}]}",
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    }
  },
  "Outputs": {
    "TaskArn": {
      "Value": {
        "Ref": "Task"
      },
      "Condition": "Enabled"
    }
  },
  "Rules": {
    "AcknowledgeCost": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Or": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "EnableResources"
                  },
                  "false"
                ]
              },
              {
                "Fn::Equals": [
                  {
                    "Ref": "AcknowledgeHourlyCharges"
                  },
                  "yes"
                ]
              }
            ]
          },
          "AssertDescription": "Hourly or paid-feature costs must be acknowledged before enabling this lab."
        }
      ]
    }
  }
}
