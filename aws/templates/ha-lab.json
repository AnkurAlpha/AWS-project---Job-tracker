{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Cost-gated two-AZ ALB/Auto Scaling reference. Desired/min/max capacity all start at zero. Supply a prepared app AMI.",
  "Metadata": {
    "DeploymentStatus": "NOT DEPLOYED; offline smoke only",
    "CostNotice": "Disabled defaults are not a promise of free operation when enabled."
  },
  "Parameters": {
    "EnableResources": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    },
    "ProjectName": {
      "Type": "String",
      "Default": "jobtracker-lab",
      "MaxLength": 24,
      "AllowedPattern": "[a-z][a-z0-9-]{2,23}"
    },
    "AcknowledgeHourlyCharges": {
      "Type": "String",
      "Default": "no",
      "AllowedValues": [
        "no",
        "yes"
      ],
      "Description": "This lab has ongoing costs and may require a Paid plan. Never upgrade automatically."
    },
    "PreparedApplicationAmiId": {
      "Type": "AWS::EC2::Image::Id"
    },
    "PrivateSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "PublicSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "AppSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "EdgeSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "InstanceProfileName": {
      "Type": "String"
    },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws[a-z-]*:acm:.*"
    }
  },
  "Conditions": {
    "Enabled": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "EnableResources"
            },
            "true"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "AcknowledgeHourlyCharges"
            },
            "yes"
          ]
        }
      ]
    }
  },
  "Resources": {
    "Balancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Condition": "Enabled",
      "Properties": {
        "Scheme": "internet-facing",
        "Type": "application",
        "Subnets": {
          "Ref": "PublicSubnetIds"
        },
        "SecurityGroups": [
          {
            "Ref": "EdgeSecurityGroupId"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "deletion_protection.enabled",
            "Value": "true"
          },
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "Targets": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Condition": "Enabled",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "Protocol": "HTTP",
        "Port": 5000,
        "TargetType": "instance",
        "HealthCheckPath": "/health",
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "Https": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Condition": "Enabled",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Balancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Targets"
            }
          }
        ]
      }
    },
    "HttpRedirect": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Condition": "Enabled",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Balancer"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "StatusCode": "HTTP_301"
            }
          }
        ]
      }
    },
    "Launch": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Condition": "Enabled",
      "Properties": {
        "LaunchTemplateData": {
          "ImageId": {
            "Ref": "PreparedApplicationAmiId"
          },
          "InstanceType": "t3.small",
          "IamInstanceProfile": {
            "Name": {
              "Ref": "InstanceProfileName"
            }
          },
          "SecurityGroupIds": [
            {
              "Ref": "AppSecurityGroupId"
            }
          ],
          "MetadataOptions": {
            "HttpTokens": "required",
            "HttpPutResponseHopLimit": 2
          },
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/xvda",
              "Ebs": {
                "Encrypted": true,
                "VolumeSize": 16,
                "VolumeType": "gp3",
                "DeleteOnTermination": true
              }
            }
          ],
          "CreditSpecification": {
            "CpuCredits": "standard"
          },
          "Monitoring": {
            "Enabled": false
          }
        }
      }
    },
    "Autoscaling": {
      "Type": "AWS::AutoScaling::AutoScalingGroup",
      "Condition": "Enabled",
      "Properties": {
        "MinSize": "0",
        "MaxSize": "0",
        "DesiredCapacity": "0",
        "VPCZoneIdentifier": {
          "Ref": "PrivateSubnetIds"
        },
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "Launch"
          },
          "Version": {
            "Fn::GetAtt": [
              "Launch",
              "LatestVersionNumber"
            ]
          }
        },
        "TargetGroupARNs": [
          {
            "Ref": "Targets"
          }
        ],
        "HealthCheckType": "ELB",
        "HealthCheckGracePeriod": 180,
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            },
            "PropagateAtLaunch": true
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation",
            "PropagateAtLaunch": true
          }
        ]
      }
    }
  },
  "Outputs": {
    "AutoScalingGroup": {
      "Value": {
        "Ref": "Autoscaling"
      },
      "Condition": "Enabled"
    },
    "LoadBalancerDns": {
      "Value": {
        "Fn::GetAtt": [
          "Balancer",
          "DNSName"
        ]
      },
      "Condition": "Enabled"
    }
  },
  "Rules": {
    "AcknowledgeCost": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Or": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "EnableResources"
                  },
                  "false"
                ]
              },
              {
                "Fn::Equals": [
                  {
                    "Ref": "AcknowledgeHourlyCharges"
                  },
                  "yes"
                ]
              }
            ]
          },
          "AssertDescription": "Hourly or paid-feature costs must be acknowledged before enabling this lab."
        }
      ]
    }
  }
}
