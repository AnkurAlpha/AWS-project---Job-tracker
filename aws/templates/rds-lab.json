{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Cost-gated private encrypted PostgreSQL; Multi-AZ/read replica are additional explicit choices.",
  "Metadata": {
    "DeploymentStatus": "NOT DEPLOYED; offline smoke only",
    "CostNotice": "Disabled defaults are not a promise of free operation when enabled."
  },
  "Parameters": {
    "EnableResources": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    },
    "ProjectName": {
      "Type": "String",
      "Default": "jobtracker-lab",
      "MaxLength": 24,
      "AllowedPattern": "[a-z][a-z0-9-]{2,23}"
    },
    "AcknowledgeHourlyCharges": {
      "Type": "String",
      "Default": "no",
      "AllowedValues": [
        "no",
        "yes"
      ],
      "Description": "This lab has ongoing costs and may require a Paid plan. Never upgrade automatically."
    },
    "PrivateSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "DatabaseSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "MultiAZ": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    },
    "EnableReadReplica": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    }
  },
  "Conditions": {
    "Enabled": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "EnableResources"
            },
            "true"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "AcknowledgeHourlyCharges"
            },
            "yes"
          ]
        }
      ]
    },
    "ReplicaEnabled": {
      "Fn::And": [
        {
          "Condition": "Enabled"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "EnableReadReplica"
            },
            "true"
          ]
        }
      ]
    }
  },
  "Resources": {
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Condition": "Enabled",
      "Properties": {
        "DBSubnetGroupDescription": "Private database tier",
        "SubnetIds": {
          "Ref": "PrivateSubnetIds"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "Postgres": {
      "Type": "AWS::RDS::DBInstance",
      "Condition": "Enabled",
      "Properties": {
        "Engine": "postgres",
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "DBName": "jobtracker",
        "MasterUsername": "jobtracker_admin",
        "ManageMasterUserPassword": true,
        "MultiAZ": {
          "Ref": "MultiAZ"
        },
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurityGroupId"
          }
        ],
        "PubliclyAccessible": false,
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true,
        "AutoMinorVersionUpgrade": true,
        "EnableIAMDatabaseAuthentication": true,
        "CopyTagsToSnapshot": true,
        "EnableCloudwatchLogsExports": [
          "postgresql"
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ReadReplica": {
      "Type": "AWS::RDS::DBInstance",
      "Condition": "ReplicaEnabled",
      "Properties": {
        "SourceDBInstanceIdentifier": {
          "Ref": "Postgres"
        },
        "DBInstanceClass": "db.t4g.micro",
        "PubliclyAccessible": false,
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurityGroupId"
          }
        ],
        "DeletionProtection": true,
        "AutoMinorVersionUpgrade": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    }
  },
  "Outputs": {
    "DatabaseEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "Postgres",
          "Endpoint.Address"
        ]
      },
      "Condition": "Enabled"
    }
  },
  "Rules": {
    "AcknowledgeCost": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Or": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "EnableResources"
                  },
                  "false"
                ]
              },
              {
                "Fn::Equals": [
                  {
                    "Ref": "AcknowledgeHourlyCharges"
                  },
                  "yes"
                ]
              }
            ]
          },
          "AssertDescription": "Hourly or paid-feature costs must be acknowledged before enabling this lab."
        }
      ]
    }
  }
}
