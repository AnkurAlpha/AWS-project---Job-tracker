PORT=5000
DATABASE_URL=postgres://jobuser:Jobpass@localhost:5432/jobtracker
JWT_SECRET=
JWT_EXPIRES_IN=12h
JWT_ISSUER=job-tracker-api
JWT_AUDIENCE=job-tracker-admin
ADMIN_USERNAME=sohom-admin
ADMIN_PASSWORD=
ALLOW_ADMIN_SIGNUP=false
NODE_ENV=development
BIND_HOST=127.0.0.1
TRUST_PROXY_HOPS=0
# Dormant until an operator deliberately enables cloud integrations.
AWS_EVENTS_ENABLED=false
AWS_REGION=ap-south-1
AWS_EVENT_QUEUE_URL=
# For a future managed PostgreSQL target, enable verified TLS with a trusted CA.
DATABASE_SSL=false
DATABASE_SSL_CA_FILE=
